# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret! Server only. Used by the quote form, the rank cron and the demo seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The public address of the site (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch niche shown first everywhere (roofing, plumbing, remodeling, landscaping, electrical, hvac, painting, flooring)
NEXT_PUBLIC_LAUNCH_CATEGORY=roofing

# Optional: Resend (https://resend.com). Without a key, lead emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=BuildProof <onboarding@resend.dev>

# Any long random string. Protects /api/cron/rank and salts IP hashes for spam limits.
CRON_SECRET=change-me-to-a-long-random-string
